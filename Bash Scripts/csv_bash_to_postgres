#!/bin/bash
set -e  # stop the script if anything fails

# Database connection
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_NAME="posey"
CSV_DIR="/home/fatima/Documents/parchposey/data-raw"

# Create the database if it’s not already there
psql -h $DB_HOST -p $DB_PORT -U $DB_USER -tc "SELECT 1 FROM pg_database WHERE datname = '$DB_NAME'" | grep -q 1 || \
psql -h $DB_HOST -p $DB_PORT -U $DB_USER -c "CREATE DATABASE $DB_NAME;"

# Set up the tables (they’ll go into the default 'public' schema)
psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME <<EOF
CREATE TABLE IF NOT EXISTS accounts (
    id INT PRIMARY KEY,
    name TEXT,
    website TEXT,
    lat DECIMAL(9,6),
    long DECIMAL(9,6),
    primary_poc TEXT,
    sales_rep_id INT
);

CREATE TABLE IF NOT EXISTS orders (
    id INT PRIMARY KEY,
    account_id INT REFERENCES accounts(id),
    occurred_at TIMESTAMP,
    standard_qty INT,
    gloss_qty INT,
    poster_qty INT,
    total INT,
    standard_amt_usd NUMERIC(10,2),
    gloss_amt_usd NUMERIC(10,2),
    poster_amt_usd NUMERIC(10,2),
    total_amt_usd NUMERIC(10,2)
);

CREATE TABLE IF NOT EXISTS region (
    id INT PRIMARY KEY,
    name TEXT
);

CREATE TABLE IF NOT EXISTS sales_reps (
    id INT PRIMARY KEY,
    name TEXT,
    region_id INT REFERENCES region(id)
);

CREATE TABLE IF NOT EXISTS web_events (
    id INT PRIMARY KEY,
    account_id INT REFERENCES accounts(id),
    occurred_at TIMESTAMP,
    channel TEXT
);
EOF

# Tell the script which file goes with which table
declare -A tables
tables=(
    ["accounts"]="accounts.csv"
    ["orders"]="orders.csv"
    ["region"]="region.csv"
    ["sales_reps"]="sales_reps.csv"
    ["web_events"]="web_events.csv"
)

# Import order matters (foreign keys need their parent tables first)
import_order=("region" "accounts" "sales_reps" "orders" "web_events")

# Loop through each table and load the matching CSV
for TABLE in "${import_order[@]}"; do
    FILE="${CSV_DIR}/${tables[$TABLE]}"
    if [[ -f "$FILE" ]]; then
        echo "Loading $FILE into $TABLE..."
        psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME \
            -c "\COPY $TABLE FROM '$FILE' WITH CSV HEADER;"
        echo "$TABLE done."
    else
        echo "$FILE not found, skipping..."
    fi
done
